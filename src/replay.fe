use super::codec::{
    canonical_attempt_seed,
    canonical_generation_fingerprint,
    canonical_run_fingerprint,
    canonical_value_digest,
}
use super::outcome::ErrorCode
use super::strategy::{GenerationResult, Strategy, U256Range, generate}
use std::evm::random::{KeccakRng, Rng}

pub const GENERATION_ALGORITHM_VERSION_V1: u256 = 1
pub const GENERATION_EDGE_POLICY_VERSION_V1: u256 = 1
pub const DIGEST_FORMAT_VERSION_V1: u256 = 1
pub const CAPSULE_FORMAT_VERSION_V1: u256 = 1
pub const ERROR_INVALID_EDGE_INDEX: u256 = 300
pub const ERROR_GENERATION_FINGERPRINT_MISMATCH: u256 = 301

pub struct RunConfig {
    pub suite_id: u256,
    pub namespace: u256,
    pub target_valid_cases: u256,
    pub max_discards: u256,
    pub max_shrink_evaluations: u256,
    pub max_state_evaluations: u256,
    pub max_deployments: u256,
    pub digest_format_version: u256,
    pub capsule_format_version: u256,
    pub codec_fingerprint: u256,
}

impl Copy for RunConfig {}

pub fn u256_strategy_fingerprint(_ strategy: U256Range) -> u256 {
    strategy.fingerprint()
}

pub fn generation_fingerprint(_ strategy_fingerprint: u256) -> u256 {
    canonical_generation_fingerprint(
        GENERATION_ALGORITHM_VERSION_V1,
        GENERATION_EDGE_POLICY_VERSION_V1,
        strategy_fingerprint,
    )
}

pub fn run_fingerprint(_ generation: u256, _ config: RunConfig) -> u256 {
    canonical_run_fingerprint(
        generation,
        config.suite_id,
        config.namespace,
        config.target_valid_cases,
        config.max_discards,
        config.max_shrink_evaluations,
        config.max_state_evaluations,
        config.max_deployments,
        config.digest_format_version,
        config.capsule_format_version,
        config.codec_fingerprint,
    )
}

pub fn attempt_seed(_ master_seed: u256, _ attempt_index: u256, _ generation: u256) -> u256 {
    canonical_attempt_seed(master_seed, attempt_index, generation)
}

pub fn value_digest(_ strategy_fingerprint: u256, _ value: u256) -> u256 {
    canonical_value_digest(strategy_fingerprint, value)
}

pub fn u256_edge_count(_ strategy: U256Range) -> u256 {
    if strategy.lo > strategy.hi {
        return 0
    }
    if strategy.lo == strategy.hi {
        return 1
    }
    if strategy.hi == strategy.lo + 1 {
        return 2
    }
    3
}

pub fn u256_edge_at(_ strategy: U256Range, _ edge_index: u256) -> GenerationResult<u256> {
    match strategy.validate() {
        Option::Some(error) => {
            return GenerationResult::InfrastructureError(error)
        },
        Option::None => {},
    }
    let count = u256_edge_count(strategy)
    if edge_index >= count {
        return GenerationResult::InfrastructureError(
            ErrorCode { kind: ERROR_INVALID_EDGE_INDEX, detail: edge_index },
        )
    }
    if edge_index == 0 {
        return GenerationResult::Value(strategy.lo)
    }
    if edge_index == 1 {
        return GenerationResult::Value(strategy.lo + 1)
    }
    GenerationResult::Value(strategy.hi)
}

pub fn generate_u256_attempt(
    _ strategy: U256Range,
    _ master_seed: u256,
    _ generation: u256,
    _ attempt_index: u256,
) -> GenerationResult<u256> {
    match strategy.validate() {
        Option::Some(error) => {
            return GenerationResult::InfrastructureError(error)
        },
        Option::None => {},
    }

    let expected_generation = generation_fingerprint(strategy.fingerprint())
    if generation != expected_generation {
        return GenerationResult::InfrastructureError(
            ErrorCode { kind: ERROR_GENERATION_FINGERPRINT_MISMATCH, detail: generation },
        )
    }

    let edge_count = u256_edge_count(strategy)
    if attempt_index < edge_count {
        return u256_edge_at(strategy, attempt_index)
    }

    var rng = KeccakRng::seeded(attempt_seed(master_seed, attempt_index, generation))
    with (Rng = rng) {
        generate(strategy)
    }
}
