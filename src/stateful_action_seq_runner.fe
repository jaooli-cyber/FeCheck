/// Exact Target/ActorA/ActorB deployment count of the experimental P0 runner.
pub const STATEFUL_P0_DEPLOYMENTS_PER_EVALUATION_V1: u256 = 3

pub const ERROR_STATEFUL_ACTIONS_EXCEED_SEQUENCE: u256 = 507
pub const ERROR_STATEFUL_PASS_INCOMPLETE_ACTIONS: u256 = 508

/// Pre-deployment request. The preflight callback deliberately cannot inspect
/// the generated action sequence.
pub struct StatefulFixtureRequest { pub context: StatefulEvaluationContext }

impl Copy for StatefulFixtureRequest {}

/// One scheduler-owned stateful property request.
pub struct StatefulActionSeqRequest<const N: usize> {
    pub value: ActionSeq<u256, N>,
    pub context: StatefulEvaluationContext,
}

impl<const N: usize> Copy for StatefulActionSeqRequest<N> {}

/// Result of the adapter's observational, non-mutating address preflight.
///
/// Read-only behavior is an adapter obligation. Fe's effect row forwards the
/// EVM capability but cannot enforce that obligation, which is one reason the
/// runner is explicitly experimental rather than certified.
pub enum StatefulFixturePreflight {
    Ready,
    InfrastructureError { pub error: ErrorCode },
}

impl Copy for StatefulFixturePreflight {}

/// Result returned after one fresh P0 fixture has been exercised.
///
/// Returning from the evaluator is an adapter assertion that all three typed
/// CREATE2 deployments completed. A direct deployment revert escapes the
/// outer evaluation and therefore produces no structured receipt.
pub struct StatefulEvaluationReceipt { pub verdict: PropertyVerdict, pub actions_executed: u256 }

impl Copy for StatefulEvaluationReceipt {}

/// Ingot-level adapter hook. It lets a higher-level boundary verify richer
/// callback evidence before the scheduler accounts the ordinary receipt.
pub(ingot) struct StatefulEvaluationVerificationRequest<const N: usize, R: Copy> {
    pub request: StatefulActionSeqRequest<N>,
    pub receipt: R,
}

impl<const N: usize, R: Copy> Copy for StatefulEvaluationVerificationRequest<N, R> {}

fn accept_experimental_receipt<const N: usize>(
    _ verification: StatefulEvaluationVerificationRequest<N, StatefulEvaluationReceipt>,
) -> StatefulEvaluationReceipt {
    verification.receipt
}

/// Structured outcome plus the caller-owned namespace registry.
pub struct StatefulActionSeqRunReport<const N: usize> {
    pub outcome: RunOutcome<ActionSeq<u256, N>>,
    pub registry: StatefulRunRegistry,
}

impl<const N: usize> Copy for StatefulActionSeqRunReport<N> {}

enum StatefulEvaluationPhase {
    Original,
    Shrink,
}

impl Copy for StatefulEvaluationPhase {}

enum StatefulEvaluationStep {
    Evaluated {
        pub stats: RunStats,
        pub shrink: ShrinkStats,
        pub verdict: PropertyVerdict,
    },
    InfrastructureError {
        pub error: ErrorCode,
        pub stats: RunStats,
        pub shrink: ShrinkStats,
        pub claim_committed: bool,
    },
}

impl Copy for StatefulEvaluationStep {}

enum StatefulU256ActionSeqShrinkResult<const N: usize> {
    Complete {
        pub minimal: ActionSeq<u256, N>,
        pub stats: RunStats,
        pub shrink: ShrinkStats,
        pub status: ShrinkStatus,
    },
    InfrastructureError {
        pub error: ErrorCode,
        pub stats: RunStats,
        pub shrink: ShrinkStats,
    },
}

impl<const N: usize> Copy for StatefulU256ActionSeqShrinkResult<N> {}

fn p0_fixture_plan() -> StatefulFixturePlan {
    StatefulFixturePlan { deployments_per_evaluation: STATEFUL_P0_DEPLOYMENTS_PER_EVALUATION_V1 }
}

fn action_seq_descriptor_or_zero<const N: usize>(_ value: ActionSeq<u256, N>) -> u256 {
    match action_seq_u256_descriptor(value) {
        Result::Ok(descriptor) => descriptor,
        Result::Err(_) => 0,
    }
}

fn stateful_action_seq_report<const N: usize>(
    _ outcome: RunOutcome<ActionSeq<u256, N>>,
    _ registry: StatefulRunRegistry,
) -> StatefulActionSeqRunReport<N> {
    StatefulActionSeqRunReport { outcome, registry }
}

fn stateful_action_seq_configuration_error<const N: usize>(
    _ error: ErrorCode,
    _ registry: StatefulRunRegistry,
) -> StatefulActionSeqRunReport<N> {
    stateful_action_seq_report(
        RunOutcome::ConfigurationError { error, stats: empty_run_stats() },
        registry,
    )
}

fn stateful_action_seq_infrastructure_error<const N: usize>(
    _ error: ErrorCode,
    _ stats: RunStats,
    _ registry: StatefulRunRegistry,
) -> StatefulActionSeqRunReport<N> {
    stateful_action_seq_report(RunOutcome::InfrastructureError { error, stats }, registry)
}

fn stateful_should_evaluate_original_attempt(
    _ stats: RunStats,
    _ config: RunConfig,
    _ attempt_ceiling: Option<u256>,
) -> bool {
    match attempt_ceiling {
        Option::Some(last_attempt_index) => stats.attempts <= last_attempt_index,
        Option::None => stats.valid_cases < config.target_valid_cases,
    }
}

fn stateful_shrink_infrastructure<const N: usize>(
    _ error: ErrorCode,
    _ stats: RunStats,
    _ shrink: ShrinkStats,
) -> StatefulU256ActionSeqShrinkResult<N> {
    StatefulU256ActionSeqShrinkResult::InfrastructureError { error, stats, shrink }
}

fn evaluate_stateful_once<
    const N: usize,
    R: Copy,
    P: Fn(StatefulFixtureRequest) -> StatefulFixturePreflight,
    X: Fn(StatefulActionSeqRequest<N>) -> R,
    V: Fn(StatefulEvaluationVerificationRequest<N, R>) -> StatefulEvaluationReceipt,
>(
    _ config: RunConfig,
    _ value: ActionSeq<u256, N>,
    _ context: StatefulEvaluationContext,
    _ phase: StatefulEvaluationPhase,
    _ prior_stats: RunStats,
    _ prior_shrink: ShrinkStats,
    _ preflight: P,
    _ evaluate: X,
    _ verify: V,
) -> StatefulEvaluationStep
uses (P::E, X::E, V::E)
{
    var proposal_stats = prior_stats
    var required_deployments: u256 = 0
    match admit_stateful_evaluation(config, p0_fixture_plan(), prior_stats) {
        StatefulAdmission::Admitted { stats, required_deployments: required } => {
            proposal_stats = stats
            required_deployments = required
        },
        StatefulAdmission::Rejected { error, stats } => {
            return StatefulEvaluationStep::InfrastructureError {
                error,
                stats,
                shrink: prior_shrink,
                claim_committed: false,
            }
        },
    }

    if required_deployments != STATEFUL_P0_DEPLOYMENTS_PER_EVALUATION_V1 {
        return StatefulEvaluationStep::InfrastructureError {
            error: ErrorCode {
                kind: ERROR_STATEFUL_ACCOUNTING_MISMATCH,
                detail: required_deployments,
            },
            stats: prior_stats,
            shrink: prior_shrink,
            claim_committed: false,
        }
    }

    match preflight(StatefulFixtureRequest { context }) {
        StatefulFixturePreflight::Ready => {},
        StatefulFixturePreflight::InfrastructureError { error } => {
            return StatefulEvaluationStep::InfrastructureError {
                error,
                stats: prior_stats,
                shrink: prior_shrink,
                claim_committed: false,
            }
        },
    }

    var stats = proposal_stats
    var shrink = prior_shrink
    match phase {
        StatefulEvaluationPhase::Original => stats.attempts += 1,
        StatefulEvaluationPhase::Shrink => shrink.evaluations += 1,
    }
    stats.property_evaluations += 1

    let request = StatefulActionSeqRequest { value, context }
    let unverified = evaluate(request)
    let receipt = verify(
        StatefulEvaluationVerificationRequest { request, receipt: unverified },
    )
    stats.contract_deployments += required_deployments

    let logical_len = action_seq_len(value) as u256
    if receipt.actions_executed > logical_len {
        return StatefulEvaluationStep::InfrastructureError {
            error: ErrorCode {
                kind: ERROR_STATEFUL_ACTIONS_EXCEED_SEQUENCE,
                detail: receipt.actions_executed,
            },
            stats,
            shrink,
            claim_committed: true,
        }
    }

    stats.actions_executed += receipt.actions_executed
    match receipt.verdict {
        PropertyVerdict::Pass => {
            if receipt.actions_executed != logical_len {
                return StatefulEvaluationStep::InfrastructureError {
                    error: ErrorCode {
                        kind: ERROR_STATEFUL_PASS_INCOMPLETE_ACTIONS,
                        detail: receipt.actions_executed,
                    },
                    stats,
                    shrink,
                    claim_committed: true,
                }
            }
        },
        _ => {},
    }

    StatefulEvaluationStep::Evaluated { stats, shrink, verdict: receipt.verdict }
}

fn shrink_u256_action_seq_stateful_prevalidated<
    const N: usize,
    R: Copy,
    P: Fn(StatefulFixtureRequest) -> StatefulFixturePreflight,
    X: Fn(StatefulActionSeqRequest<N>) -> R,
    V: Fn(StatefulEvaluationVerificationRequest<N, R>) -> StatefulEvaluationReceipt,
>(
    _ strategy: U256ActionSeqStrategy<N>,
    _ original: ActionSeq<u256, N>,
    _ failure: FailureKey,
    _ master_seed: u256,
    _ semantic_run_fingerprint: u256,
    _ fixture_domain: u256,
    _ execution_namespace: u256,
    _ attempt_index: u256,
    _ config: RunConfig,
    _ starting_stats: RunStats,
    _ preflight: P,
    _ evaluate: X,
    _ verify: V,
) -> StatefulU256ActionSeqShrinkResult<N>
uses (P::E, X::E, V::E)
{
    var run_stats = starting_stats
    var shrink = empty_shrink_stats()
    var current = original
    var cursor = match u256_action_seq_shrink_start(strategy, current) {
        Result::Ok(cursor) => cursor,
        Result::Err(error) => {
            return stateful_shrink_infrastructure(error, run_stats, shrink)
        },
    }

    while true {
        match u256_action_seq_shrink_next(cursor) {
            U256ActionSeqShrinkStep::Done => {
                return StatefulU256ActionSeqShrinkResult::Complete {
                    minimal: current,
                    stats: run_stats,
                    shrink,
                    status: ShrinkStatus::CompleteLocal,
                }
            },
            U256ActionSeqShrinkStep::Candidate { value, cursor: next } => {
                if shrink.evaluations == config.max_shrink_evaluations {
                    return StatefulU256ActionSeqShrinkResult::Complete {
                        minimal: current,
                        stats: run_stats,
                        shrink,
                        status: ShrinkStatus::PartialBudget,
                    }
                }
                if !u256_action_seq_contains(strategy, value) {
                    return stateful_shrink_infrastructure(
                        ErrorCode {
                            kind: ERROR_INVALID_SHRINK_CANDIDATE,
                            detail: action_seq_descriptor_or_zero(value),
                        },
                        run_stats,
                        shrink,
                    )
                }
                let decreases = match u256_action_seq_rank_less(strategy, value, current) {
                    Result::Ok(decreases) => decreases,
                    Result::Err(error) => {
                        return stateful_shrink_infrastructure(error, run_stats, shrink)
                    },
                }
                if !decreases {
                    return stateful_shrink_infrastructure(
                        ErrorCode {
                            kind: ERROR_INVALID_SHRINK_CANDIDATE,
                            detail: action_seq_descriptor_or_zero(value),
                        },
                        run_stats,
                        shrink,
                    )
                }

                let context = StatefulEvaluationContext {
                    run_fingerprint: semantic_run_fingerprint,
                    suite_id: config.suite_id,
                    run_namespace: config.namespace,
                    execution_namespace,
                    fixture_domain,
                    master_seed,
                    attempt_index,
                    local_evaluation_index: shrink.evaluations + 1,
                }
                match evaluate_stateful_once(
                    config,
                    value,
                    context,
                    StatefulEvaluationPhase::Shrink,
                    run_stats,
                    shrink,
                    preflight,
                    evaluate,
                    verify,
                ) {
                    StatefulEvaluationStep::InfrastructureError {
                        error,
                        stats,
                        shrink: evaluated_shrink,
                        claim_committed: _,
                    } => {
                        return stateful_shrink_infrastructure(error, stats, evaluated_shrink)
                    },
                    StatefulEvaluationStep::Evaluated {
                        stats,
                        shrink: evaluated_shrink,
                        verdict,
                    } => {
                        run_stats = stats
                        shrink = evaluated_shrink
                        match verdict {
                            PropertyVerdict::Pass => {
                                shrink.rejected_pass += 1
                                cursor = next
                            },
                            PropertyVerdict::Discard => {
                                shrink.rejected_discard += 1
                                cursor = next
                            },
                            PropertyVerdict::Fail(candidate_failure) => {
                                if failure_key_equal(candidate_failure, failure) {
                                    shrink.accepted += 1
                                    current = value
                                    cursor = match u256_action_seq_shrink_start(strategy, current) {
                                        Result::Ok(restarted) => restarted,
                                        Result::Err(error) => {
                                            return stateful_shrink_infrastructure(
                                                error,
                                                run_stats,
                                                shrink,
                                            )
                                        },
                                    }
                                } else {
                                    shrink.rejected_failure_key += 1
                                    cursor = next
                                }
                            },
                            PropertyVerdict::InfrastructureError(error) => {
                                return stateful_shrink_infrastructure(error, run_stats, shrink)
                            },
                        }
                    },
                }
            },
        }
    }

    stateful_shrink_infrastructure(
        ErrorCode {
            kind: ERROR_INVALID_SHRINK_CANDIDATE,
            detail: action_seq_descriptor_or_zero(current),
        },
        run_stats,
        shrink,
    )
}

/// Ingot-level scheduler core with separate semantic and execution identity.
///
/// Generation and capsule validation remain bound to `config` and
/// `semantic_run_fingerprint`. `fixture_domain` and `execution_namespace`
/// govern only fixture salts and the caller-owned registry claim. When an
/// attempt ceiling is present, the scheduler evaluates exactly through that
/// historical attempt unless a failure or infrastructure error stops it.
pub(ingot) fn check_u256_action_seq_stateful_with_execution<
    const N: usize,
    R: Copy,
    P: Fn(StatefulFixtureRequest) -> StatefulFixturePreflight,
    X: Fn(StatefulActionSeqRequest<N>) -> R,
    V: Fn(StatefulEvaluationVerificationRequest<N, R>) -> StatefulEvaluationReceipt,
>(
    _ strategy: U256ActionSeqStrategy<N>,
    _ master_seed: u256,
    _ config: RunConfig,
    _ registry: StatefulRunRegistry,
    _ semantic_run_fingerprint: u256,
    _ fixture_domain: u256,
    _ execution_namespace: u256,
    _ attempt_ceiling: Option<u256>,
    _ preflight: P,
    _ evaluate: X,
    _ verify: V,
) -> StatefulActionSeqRunReport<N>
uses (P::E, X::E, V::E)
{
    match validate_run_config_for_codec(config, action_seq_u256_codec_fingerprint()) {
        Option::Some(error) => {
            return stateful_action_seq_configuration_error(error, registry)
        },
        Option::None => {},
    }
    match u256_action_seq_validate(strategy) {
        Option::Some(error) => {
            return stateful_action_seq_configuration_error(error, registry)
        },
        Option::None => {},
    }
    match validate_stateful_fixture_plan(config, p0_fixture_plan()) {
        Option::Some(error) => {
            return stateful_action_seq_configuration_error(error, registry)
        },
        Option::None => {},
    }

    var stats = empty_run_stats()
    if config.target_valid_cases == 0 {
        return stateful_action_seq_report(RunOutcome::Passed { stats }, registry)
    }

    let proposed_registry = match stateful_run_registry_claim(
        registry,
        config.suite_id,
        execution_namespace,
    ) {
        StatefulRunRegistryClaim::Claimed { registry } => registry,
        StatefulRunRegistryClaim::Rejected { error, registry } => {
            return stateful_action_seq_configuration_error(error, registry)
        },
    }
    var active_registry = registry

    let generation = generation_fingerprint(u256_action_seq_fingerprint(strategy))
    while stateful_should_evaluate_original_attempt(stats, config, attempt_ceiling) {
        let attempt_index = stats.attempts
        let value = match generate_u256_action_seq_attempt(
            strategy,
            master_seed,
            generation,
            attempt_index,
        ) {
            GenerationResult::Value(value) => value,
            GenerationResult::InfrastructureError(error) => {
                return stateful_action_seq_infrastructure_error(error, stats, active_registry)
            },
        }
        let context = StatefulEvaluationContext {
            run_fingerprint: semantic_run_fingerprint,
            suite_id: config.suite_id,
            run_namespace: config.namespace,
            execution_namespace,
            fixture_domain,
            master_seed,
            attempt_index,
            local_evaluation_index: 0,
        }
        let verdict = match evaluate_stateful_once(
            config,
            value,
            context,
            StatefulEvaluationPhase::Original,
            stats,
            empty_shrink_stats(),
            preflight,
            evaluate,
            verify,
        ) {
            StatefulEvaluationStep::InfrastructureError {
                error,
                stats: failed_stats,
                shrink: _,
                claim_committed,
            } => {
                if claim_committed {
                    active_registry = proposed_registry
                }
                return stateful_action_seq_infrastructure_error(
                    error,
                    failed_stats,
                    active_registry,
                )
            },
            StatefulEvaluationStep::Evaluated { stats: evaluated_stats, shrink: _, verdict } => {
                active_registry = proposed_registry
                stats = evaluated_stats
                verdict
            },
        }

        match verdict {
            PropertyVerdict::Pass => stats.valid_cases += 1,
            PropertyVerdict::Discard => {
                stats.discards += 1
                if stats.discards > config.max_discards {
                    match attempt_ceiling {
                        Option::Some(_) => {},
                        Option::None => {
                            return stateful_action_seq_report(
                                RunOutcome::Exhausted {
                                    reason: ExhaustionReason::MaxDiscards,
                                    stats,
                                },
                                active_registry,
                            )
                        },
                    }
                }
            },
            PropertyVerdict::InfrastructureError(error) => {
                return stateful_action_seq_infrastructure_error(error, stats, active_registry)
            },
            PropertyVerdict::Fail(failure) => {
                match shrink_u256_action_seq_stateful_prevalidated(
                    strategy,
                    value,
                    failure,
                    master_seed,
                    semantic_run_fingerprint,
                    fixture_domain,
                    execution_namespace,
                    attempt_index,
                    config,
                    stats,
                    preflight,
                    evaluate,
                    verify,
                ) {
                    StatefulU256ActionSeqShrinkResult::Complete {
                        minimal,
                        stats,
                        shrink,
                        status,
                    } => {
                        return stateful_action_seq_report(
                            RunOutcome::Falsified {
                                original: value,
                                minimal,
                                failure,
                                stats,
                                shrink,
                                shrink_status: status,
                            },
                            active_registry,
                        )
                    },
                    StatefulU256ActionSeqShrinkResult::InfrastructureError {
                        error,
                        stats,
                        shrink: _,
                    } => {
                        return stateful_action_seq_infrastructure_error(
                            error,
                            stats,
                            active_registry,
                        )
                    },
                }
            },
        }
    }

    stateful_action_seq_report(RunOutcome::Passed { stats }, active_registry)
}

/// Experimental, non-certified P0 stateful sequence runner.
///
/// The root ingot owns deterministic generation, evaluation identity,
/// admission, counters, and shrinking. Consumer callbacks own EVM observation,
/// three direct typed deployments, a fresh local model, and action execution.
/// The type system forwards those effects but cannot prove the callback
/// protocol. This function therefore does not produce a replay capsule and
/// must not be described as a certified stateful boundary.
pub fn check_u256_action_seq_stateful_experimental<
    const N: usize,
    P: Fn(StatefulFixtureRequest) -> StatefulFixturePreflight,
    X: Fn(StatefulActionSeqRequest<N>) -> StatefulEvaluationReceipt,
>(
    _ strategy: U256ActionSeqStrategy<N>,
    _ master_seed: u256,
    _ config: RunConfig,
    _ registry: StatefulRunRegistry,
    _ preflight: P,
    _ evaluate: X,
) -> StatefulActionSeqRunReport<N>
uses (P::E, X::E)
{
    let generation = generation_fingerprint(u256_action_seq_fingerprint(strategy))
    let run_id = run_fingerprint(generation, config)
    check_u256_action_seq_stateful_with_execution(
        strategy,
        master_seed,
        config,
        registry,
        run_id,
        run_id,
        config.namespace,
        Option::None,
        preflight,
        evaluate,
        accept_experimental_receipt,
    )
}
