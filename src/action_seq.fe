use super::outcome::ErrorCode
use std::evm::keccak_words

pub const ERROR_INVALID_ACTION_SEQUENCE: u256 = 100

const DOMAIN_ACTION_SEQ_SPIKE_V0: u256 = 0x4645434845434b2f5350494b452f414354494f4e5345512f5630000000000000

pub struct ActionSeq<A, const N: usize> { pub items: [A; N], pub len: usize }

impl<A, const N: usize> Copy for ActionSeq<A, N> where A: Copy {}

pub fn action_seq_is_valid<A, const N: usize>(
    _ sequence: ActionSeq<A, N>,
    _ max_actions: usize,
) -> bool
where A: Copy
{
    sequence.len <= max_actions && max_actions <= N
}

/// Non-wire feasibility spike. It proves logical tail independence but is not
/// the canonical replay codec; the stateful ActionSeq codec remains pending.
pub fn action_seq_u256_digest_spike<const N: usize>(_ sequence: ActionSeq<u256, N>) -> Result<
    ErrorCode,
    u256,
> {
    if sequence.len > N {
        return Result::Err(
            ErrorCode { kind: ERROR_INVALID_ACTION_SEQUENCE, detail: sequence.len as u256 },
        )
    }

    var digest = keccak_words([DOMAIN_ACTION_SEQ_SPIKE_V0, sequence.len as u256])
    var index: usize = 0
    while index < sequence.len {
        digest = keccak_words([digest, index as u256, sequence.items[index]])
        index += 1
    }
    Result::Ok(digest)
}
