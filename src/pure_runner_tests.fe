use ingot::{
    ErrorCode,
    ExhaustionReason,
    FailureKey,
    PureU256Property,
    PropertyVerdict,
    RunConfig,
    RunOutcome,
    ShrinkStatus,
    U256Range,
    U256ShrinkResult,
    check_u256_pure,
    shrink_u256_prevalidated,
    u256_codec_fingerprint,
}

fn base_config() -> RunConfig {
    RunConfig {
        suite_id: 1,
        namespace: 2,
        target_valid_cases: 3,
        max_discards: 10,
        max_shrink_evaluations: 100,
        max_state_evaluations: 0,
        max_deployments: 0,
        digest_format_version: 1,
        capsule_format_version: 1,
        codec_fingerprint: u256_codec_fingerprint(),
    }
}

fn pass_property(_ value: u256) -> PropertyVerdict {
    PropertyVerdict::Pass
}

fn discard_zero(_ value: u256) -> PropertyVerdict {
    if value == 0 {
        PropertyVerdict::Discard
    } else {
        PropertyVerdict::Pass
    }
}

fn fail_at_ten(_ value: u256) -> PropertyVerdict {
    if value >= 10 {
        PropertyVerdict::Fail(FailureKey { kind: 1, detail: 9 })
    } else {
        PropertyVerdict::Pass
    }
}

fn mixed_shrink_property(_ value: u256) -> PropertyVerdict {
    if value >= 11 {
        PropertyVerdict::Fail(FailureKey { kind: 1, detail: 9 })
    } else if value == 10 {
        PropertyVerdict::Discard
    } else if value == 9 {
        PropertyVerdict::Fail(FailureKey { kind: 2, detail: 9 })
    } else {
        PropertyVerdict::Pass
    }
}

fn infrastructure_property(_ value: u256) -> PropertyVerdict {
    PropertyVerdict::InfrastructureError(ErrorCode { kind: 999, detail: value })
}

struct PassProperty {}
impl Copy for PassProperty {}
impl PureU256Property for PassProperty {
    fn evaluate(self, _ value: u256) -> PropertyVerdict {
        pass_property(value)
    }
}

struct DiscardZeroProperty {}
impl Copy for DiscardZeroProperty {}
impl PureU256Property for DiscardZeroProperty {
    fn evaluate(self, _ value: u256) -> PropertyVerdict {
        discard_zero(value)
    }
}

struct FailAtTenProperty {}
impl Copy for FailAtTenProperty {}
impl PureU256Property for FailAtTenProperty {
    fn evaluate(self, _ value: u256) -> PropertyVerdict {
        fail_at_ten(value)
    }
}

struct InfrastructureProperty {}
impl Copy for InfrastructureProperty {}
impl PureU256Property for InfrastructureProperty {
    fn evaluate(self, _ value: u256) -> PropertyVerdict {
        infrastructure_property(value)
    }
}

#[test]
fn runner_counts_passes_and_handles_zero_target() {
    let strategy = U256Range { lo: 0, hi: 100, origin: 0 }
    let passed = check_u256_pure(strategy, 7, base_config(), PassProperty {})
    match passed {
        RunOutcome::Passed { stats } => {
            assert!(stats.attempts == 3)
            assert!(stats.valid_cases == 3)
            assert!(stats.discards == 0)
            assert!(stats.property_evaluations == 3)
        },
        _ => assert!(false),
    }

    var zero = base_config()
    zero.target_valid_cases = 0
    let empty = check_u256_pure(strategy, 7, zero, InfrastructureProperty {})
    match empty {
        RunOutcome::Passed { stats } => {
            assert!(stats.attempts == 0)
            assert!(stats.property_evaluations == 0)
        },
        _ => assert!(false),
    }
}

#[test]
fn first_discard_exhausts_when_max_discards_is_zero() {
    let strategy = U256Range { lo: 0, hi: 100, origin: 0 }
    var config = base_config()
    config.max_discards = 0
    let outcome = check_u256_pure(strategy, 7, config, DiscardZeroProperty {})
    match outcome {
        RunOutcome::Exhausted { reason, stats } => {
            match reason {
                ExhaustionReason::MaxDiscards => {},
            }
            assert!(stats.attempts == 1)
            assert!(stats.discards == 1)
            assert!(stats.property_evaluations == 1)
        },
        _ => assert!(false),
    }
}

#[test]
fn falsification_shrinks_and_preserves_accounting_equation() {
    let strategy = U256Range { lo: 0, hi: 100, origin: 0 }
    let outcome = check_u256_pure(strategy, 7, base_config(), FailAtTenProperty {})
    match outcome {
        RunOutcome::Falsified { original, minimal, failure, stats, shrink, shrink_status } => {
            assert!(original == 100)
            assert!(minimal == 10)
            assert!(failure.kind == 1)
            assert!(stats.attempts == 3)
            assert!(stats.valid_cases == 2)
            assert!(
                stats.property_evaluations == stats.attempts + shrink.evaluations,
            )
            match shrink_status {
                ShrinkStatus::CompleteLocal => {},
                _ => assert!(false),
            }
        },
        _ => assert!(false),
    }
}

#[test]
fn shrink_rejects_pass_discard_and_other_failure_key() {
    let strategy = U256Range { lo: 0, hi: 20, origin: 0 }
    let result = shrink_u256_prevalidated(
        strategy,
        12,
        FailureKey { kind: 1, detail: 9 },
        100,
        mixed_shrink_property,
    )
    match result {
        U256ShrinkResult::Complete { minimal, stats, status } => {
            assert!(minimal == 11)
            assert!(stats.accepted == 1)
            assert!(stats.rejected_pass > 0)
            assert!(stats.rejected_discard == 2)
            assert!(stats.rejected_failure_key == 2)
            match status {
                ShrinkStatus::CompleteLocal => {},
                _ => assert!(false),
            }
        },
        _ => assert!(false),
    }
}

#[test]
fn shrink_budget_zero_distinguishes_pending_from_empty_cursor() {
    let strategy = U256Range { lo: 0, hi: 20, origin: 0 }
    let partial = shrink_u256_prevalidated(
        strategy,
        12,
        FailureKey { kind: 1, detail: 9 },
        0,
        mixed_shrink_property,
    )
    match partial {
        U256ShrinkResult::Complete { minimal, stats, status } => {
            assert!(minimal == 12)
            assert!(stats.evaluations == 0)
            match status {
                ShrinkStatus::PartialBudget => {},
                _ => assert!(false),
            }
        },
        _ => assert!(false),
    }

    let complete = shrink_u256_prevalidated(
        strategy,
        0,
        FailureKey { kind: 1, detail: 9 },
        0,
        mixed_shrink_property,
    )
    match complete {
        U256ShrinkResult::Complete { minimal, stats, status } => {
            assert!(minimal == 0)
            assert!(stats.evaluations == 0)
            match status {
                ShrinkStatus::CompleteLocal => {},
                _ => assert!(false),
            }
        },
        _ => assert!(false),
    }
}

#[test]
fn infrastructure_and_configuration_are_not_property_failures() {
    let strategy = U256Range { lo: 0, hi: 20, origin: 0 }
    let result = shrink_u256_prevalidated(
        strategy,
        12,
        FailureKey { kind: 1, detail: 9 },
        10,
        infrastructure_property,
    )
    match result {
        U256ShrinkResult::InfrastructureError { error, stats } => {
            assert!(error.kind == 999)
            assert!(stats.evaluations == 1)
        },
        _ => assert!(false),
    }

    let invalid = U256Range { lo: 20, hi: 10, origin: 20 }
    let outcome = check_u256_pure(invalid, 7, base_config(), PassProperty {})
    match outcome {
        RunOutcome::ConfigurationError { error: _, stats } => {
            assert!(stats.attempts == 0)
            assert!(stats.property_evaluations == 0)
        },
        _ => assert!(false),
    }
}

#[test]
fn exact_shrink_budget_and_reshrink_are_stable() {
    let strategy = U256Range { lo: 0, hi: 100, origin: 0 }
    let failure = FailureKey { kind: 1, detail: 9 }

    let partial = shrink_u256_prevalidated(strategy, 100, failure, 14, fail_at_ten)
    match partial {
        U256ShrinkResult::Complete { minimal, stats, status } => {
            assert!(minimal == 10)
            assert!(stats.evaluations == 14)
            match status {
                ShrinkStatus::PartialBudget => {},
                _ => assert!(false),
            }
        },
        _ => assert!(false),
    }

    let exact = shrink_u256_prevalidated(strategy, 100, failure, 15, fail_at_ten)
    match exact {
        U256ShrinkResult::Complete { minimal, stats, status } => {
            assert!(minimal == 10)
            assert!(stats.evaluations == 15)
            match status {
                ShrinkStatus::CompleteLocal => {},
                _ => assert!(false),
            }
        },
        _ => assert!(false),
    }

    let again = shrink_u256_prevalidated(strategy, 10, failure, 15, fail_at_ten)
    match again {
        U256ShrinkResult::Complete { minimal, stats, status } => {
            assert!(minimal == 10)
            assert!(stats.accepted == 0)
            match status {
                ShrinkStatus::CompleteLocal => {},
                _ => assert!(false),
            }
        },
        _ => assert!(false),
    }
}

#[test]
fn derived_attempt_cap_rejects_oversized_configuration() {
    let strategy = U256Range { lo: 0, hi: 100, origin: 0 }
    var config = base_config()
    config.target_valid_cases = 4096
    config.max_discards = 1
    let outcome = check_u256_pure(strategy, 7, config, InfrastructureProperty {})
    match outcome {
        RunOutcome::ConfigurationError { error, stats } => {
            assert!(error.kind == 201)
            assert!(error.detail == 1)
            assert!(stats.attempts == 0)
            assert!(stats.property_evaluations == 0)
        },
        _ => assert!(false),
    }
}
