use super::codec::{
    canonical_strategy_fingerprint,
    canonical_value_digest,
    ordered_edges_descriptor,
    u256_bounds_descriptor,
}
use super::outcome::ErrorCode
use super::scalar::{
    ScalarShrinkCursor,
    ScalarShrinkStep,
    scalar_rank,
    scalar_shrink_next,
    scalar_shrink_start,
}
use std::evm::random::Rng

pub const MAX_RNG_REJECTIONS_V1: u256 = 64
pub const ERROR_INVALID_RANGE: u256 = 1
pub const ERROR_ORIGIN_OUT_OF_DOMAIN: u256 = 2
pub const ERROR_REJECTION_LIMIT: u256 = 3
pub const ERROR_VALUE_OUT_OF_DOMAIN: u256 = 4
pub const STRATEGY_KIND_U256_RANGE_V1: u256 = 1
pub const EDGE_ENUMERATION_POLICY_V1: u256 = 1
pub const SHRINK_ENUMERATION_POLICY_V1: u256 = 1
pub const VALUE_ENCODING_VERSION_V1: u256 = 1
const DESCRIPTOR_NONE: u256 = 0

pub enum GenerationResult<T> {
    Value(T),
    InfrastructureError(ErrorCode),
}

impl<T> Copy for GenerationResult<T> where T: Copy {}

pub enum StrategyShrinkStep<V, C> {
    Done,
    Candidate { pub value: V, pub cursor: C },
}

impl<V, C> Copy for StrategyShrinkStep<V, C> where V: Copy, C: Copy {}

pub trait Strategy {
    uses E
    type Value: Copy
    type Cursor: Copy

    fn validate(self) -> Option<ErrorCode>
    fn contains(self, _ value: Self::Value) -> bool
    fn origin(self) -> Self::Value
    fn rank(self, _ value: Self::Value) -> Result<ErrorCode, u256>
    fn fingerprint(self) -> u256
    fn digest(self, _ value: Self::Value) -> Result<ErrorCode, u256>
    fn random(self) -> GenerationResult<Self::Value> uses E
    fn shrink_start(self, _ value: Self::Value) -> Result<ErrorCode, Self::Cursor>
    fn shrink_next(self, _ cursor: Self::Cursor) -> StrategyShrinkStep<Self::Value, Self::Cursor>
}

pub struct U256Range { pub lo: u256, pub hi: u256, pub origin: u256 }

impl Copy for U256Range {}

#[arithmetic(unchecked)]
fn bounded_uniform(_ upper: u256) -> GenerationResult<u256>
uses (rng: mut Rng)
{
    if upper == 0 {
        return GenerationResult::InfrastructureError(
            ErrorCode { kind: ERROR_INVALID_RANGE, detail: 0 },
        )
    }

    let threshold = (0 - upper) % upper
    var rejected: u256 = 0
    while rejected < MAX_RNG_REJECTIONS_V1 {
        let word = rng.next()
        if word >= threshold {
            return GenerationResult::Value(word % upper)
        }
        rejected += 1
    }

    GenerationResult::InfrastructureError(
        ErrorCode { kind: ERROR_REJECTION_LIMIT, detail: rejected },
    )
}

impl Strategy for U256Range {
    uses E = (rng: mut Rng)
    type Value = u256
    type Cursor = ScalarShrinkCursor

    fn validate(self) -> Option<ErrorCode> {
        if self.lo > self.hi {
            return Option::Some(ErrorCode { kind: ERROR_INVALID_RANGE, detail: self.lo })
        }
        if self.origin < self.lo || self.origin > self.hi {
            return Option::Some(
                ErrorCode { kind: ERROR_ORIGIN_OUT_OF_DOMAIN, detail: self.origin },
            )
        }
        Option::None
    }

    fn contains(self, _ value: u256) -> bool {
        self.validate().is_none() && value >= self.lo && value <= self.hi
    }

    fn origin(self) -> u256 {
        self.origin
    }

    fn rank(self, _ value: u256) -> Result<ErrorCode, u256> {
        if !self.contains(value) {
            return Result::Err(
                ErrorCode { kind: ERROR_VALUE_OUT_OF_DOMAIN, detail: value },
            )
        }
        Result::Ok(scalar_rank(self.origin, value))
    }

    fn fingerprint(self) -> u256 {
        var edge_count: u256 = 1
        var edge1: u256 = 0
        var edge2: u256 = 0
        if self.hi > self.lo {
            edge_count = 2
            edge1 = self.lo + 1
            if self.hi != edge1 {
                edge_count = 3
                edge2 = self.hi
            }
        }
        canonical_strategy_fingerprint(
            STRATEGY_KIND_U256_RANGE_V1,
            u256_bounds_descriptor(self.lo, self.hi),
            self.origin,
            DESCRIPTOR_NONE,
            DESCRIPTOR_NONE,
            DESCRIPTOR_NONE,
            ordered_edges_descriptor(edge_count, self.lo, edge1, edge2),
            EDGE_ENUMERATION_POLICY_V1,
            SHRINK_ENUMERATION_POLICY_V1,
            VALUE_ENCODING_VERSION_V1,
        )
    }

    fn digest(self, _ value: u256) -> Result<ErrorCode, u256> {
        if !self.contains(value) {
            return Result::Err(
                ErrorCode { kind: ERROR_VALUE_OUT_OF_DOMAIN, detail: value },
            )
        }
        Result::Ok(canonical_value_digest(self.fingerprint(), value))
    }

    fn random(self) -> GenerationResult<u256> uses E {
        match self.validate() {
            Option::Some(error) => {
                return GenerationResult::InfrastructureError(error)
            },
            Option::None => {},
        }
        if self.lo == self.hi {
            return GenerationResult::Value(self.lo)
        }
        if self.lo == 0 && self.hi == u256::max() {
            return GenerationResult::Value(rng.next())
        }

        let span = self.hi - self.lo + 1
        match bounded_uniform(span) {
            GenerationResult::Value(offset) => GenerationResult::Value(self.lo + offset),
            GenerationResult::InfrastructureError(error) => {
                GenerationResult::InfrastructureError(error)
            },
        }
    }

    fn shrink_start(self, _ value: u256) -> Result<ErrorCode, ScalarShrinkCursor> {
        if !self.contains(value) {
            return Result::Err(
                ErrorCode { kind: ERROR_VALUE_OUT_OF_DOMAIN, detail: value },
            )
        }
        Result::Ok(scalar_shrink_start(self.origin, value))
    }

    fn shrink_next(self, _ cursor: ScalarShrinkCursor) -> StrategyShrinkStep<
        u256,
        ScalarShrinkCursor,
    > {
        match scalar_shrink_next(cursor) {
            ScalarShrinkStep::Done => StrategyShrinkStep::Done,
            ScalarShrinkStep::Candidate { value, cursor: next } => {
                StrategyShrinkStep::Candidate { value, cursor: next }
            },
        }
    }
}

pub fn generate<S: Strategy>(_ strategy: S) -> GenerationResult<S::Value>
uses S::E
{
    strategy.random()
}
