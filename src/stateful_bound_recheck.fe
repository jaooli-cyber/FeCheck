const DOMAIN_EXEC_REPLAY_V1: u256 = 0x4645434845434b2f455845432d5245504c41592f563100000000000000000000
const DOMAIN_STATEFUL_FIXTURE_EVIDENCE_V1: u256 = 0x4645434845434b2f535441544546554c2d45564944454e43452f563100000000
