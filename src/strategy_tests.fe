use ingot::{
    ERROR_REJECTION_LIMIT,
    GenerationResult,
    MAX_RNG_REJECTIONS_V1,
    ErrorCode,
    ScalarShrinkCursor,
    scalar_shrink_start,
    Strategy,
    U256Range,
    generate,
}
use std::evm::random::{ReplayRng, Rng}

fn expect_generated(_ result: GenerationResult<u256>) -> u256 {
    match result {
        GenerationResult::Value(value) => value,
        GenerationResult::InfrastructureError(_) => {
            assert!(false)
            0
        },
    }
}

fn expect_cursor(
    _ result: Result<ErrorCode, ScalarShrinkCursor>,
    _ origin: u256,
) -> ScalarShrinkCursor {
    match result {
        Result::Ok(cursor) => cursor,
        Result::Err(_) => {
            assert!(false)
            scalar_shrink_start(origin, origin)
        },
    }
}

fn expect_rank(_ result: Result<ErrorCode, u256>) -> u256 {
    match result {
        Result::Ok(rank) => rank,
        Result::Err(_) => {
            assert!(false)
            0
        },
    }
}

#[test]
fn scalar_strategy_forwards_rng_and_handles_full_domain() {
    let singleton = U256Range { lo: 7, hi: 7, origin: 7 }
    var untouched = ReplayRng::new([5, 9])
    let singleton_value = with (Rng = untouched) {
        expect_generated(generate(singleton))
    }
    assert!(singleton_value == 7)
    assert!(untouched.next() == 5)

    let full = U256Range { lo: 0, hi: u256::max(), origin: 0 }
    var consumed = ReplayRng::new([5, 9])
    let full_value = with (Rng = consumed) {
        expect_generated(generate(full))
    }
    assert!(full_value == 5)
    assert!(consumed.next() == 9)
}

#[test]
fn bounded_generation_uses_rejection_sampling_and_has_a_hard_cap() {
    let range = U256Range { lo: 0, hi: 2, origin: 0 }
    var replay = ReplayRng::new([0, 5])
    let value = with (Rng = replay) {
        expect_generated(generate(range))
    }
    assert!(value == 2)

    var rejected = ReplayRng::new([0])
    let result = with (Rng = rejected) {
        generate(range)
    }
    match result {
        GenerationResult::Value(_) => assert!(false),
        GenerationResult::InfrastructureError(error) => {
            assert!(error.kind == ERROR_REJECTION_LIMIT)
            assert!(error.detail == MAX_RNG_REJECTIONS_V1)
        },
    }
}

#[test]
fn invalid_strategy_and_value_are_rejected_before_rng_or_shrink() {
    let invalid = U256Range { lo: 10, hi: 9, origin: 10 }
    var untouched = ReplayRng::new([5, 9])
    let generated = with (Rng = untouched) {
        generate(invalid)
    }
    match generated {
        GenerationResult::Value(_) => assert!(false),
        GenerationResult::InfrastructureError(_) => {},
    }
    assert!(untouched.next() == 5)

    let valid = U256Range { lo: 10, hi: 20, origin: 10 }
    assert!(valid.shrink_start(0).is_err())
    assert!(valid.rank(0).is_err())
    assert!(valid.digest(0).is_err())
}

#[test]
fn scalar_strategy_candidates_are_in_domain_and_strict_for_small_domains() {
    var origin: u256 = 0
    while origin < 16 {
        var value: u256 = 0
        while value < 16 {
            let strategy = U256Range { lo: 0, hi: 15, origin }
            var cursor = expect_cursor(strategy.shrink_start(value), origin)
            let original_rank = expect_rank(strategy.rank(value))
            var candidates: u256 = 0
            var done = false
            while !done {
                match strategy.shrink_next(cursor) {
                    ingot::StrategyShrinkStep::Done => done = true,
                    ingot::StrategyShrinkStep::Candidate { value: candidate, cursor: next } => {
                        assert!(strategy.contains(candidate))
                        let rank = expect_rank(strategy.rank(candidate))
                        assert!(rank < original_rank)
                        cursor = next
                        candidates += 1
                        assert!(candidates <= 257)
                    },
                }
            }
            value += 1
        }
        origin += 1
    }
}

#[test]
fn top_of_u256_singleton_and_two_value_range_do_not_overflow() {
    let max = u256::max()
    let singleton = U256Range { lo: max, hi: max, origin: max }
    var untouched = ReplayRng::new([17])
    let singleton_value = with (Rng = untouched) {
        expect_generated(generate(singleton))
    }
    assert!(singleton_value == max)
    assert!(untouched.next() == 17)

    let top = U256Range { lo: max - 1, hi: max, origin: max - 1 }
    var replay = ReplayRng::new([0, 1])
    let low = with (Rng = replay) {
        expect_generated(generate(top))
    }
    let high = with (Rng = replay) {
        expect_generated(generate(top))
    }
    assert!(low == max - 1)
    assert!(high == max)

    let cursor = expect_cursor(top.shrink_start(max), max - 1)
    match top.shrink_next(cursor) {
        ingot::StrategyShrinkStep::Candidate { value, cursor: next } => {
            assert!(value == max - 1)
            match top.shrink_next(next) {
                ingot::StrategyShrinkStep::Done => {},
                _ => assert!(false),
            }
        },
        _ => assert!(false),
    }
}
