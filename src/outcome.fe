pub struct FailureKey { pub kind: u256, pub detail: u256 }

impl Copy for FailureKey {}

pub fn failure_key_equal(_ left: FailureKey, _ right: FailureKey) -> bool {
    left.kind == right.kind && left.detail == right.detail
}

pub struct ErrorCode { pub kind: u256, pub detail: u256 }

impl Copy for ErrorCode {}

pub enum PropertyVerdict {
    Pass,
    Discard,
    Fail(FailureKey),
    InfrastructureError(ErrorCode),
}

impl Copy for PropertyVerdict {}

pub struct RunStats {
    pub attempts: u256,
    pub valid_cases: u256,
    pub discards: u256,
    pub property_evaluations: u256,
    pub fixture_evaluations: u256,
    pub contract_deployments: u256,
    pub actions_executed: u256,
}

impl Copy for RunStats {}

pub struct ShrinkStats {
    pub evaluations: u256,
    pub accepted: u256,
    pub rejected_pass: u256,
    pub rejected_discard: u256,
    pub rejected_failure_key: u256,
}

impl Copy for ShrinkStats {}

pub enum ShrinkStatus {
    CompleteLocal,
    PartialBudget,
}

impl Copy for ShrinkStatus {}

pub enum ExhaustionReason {
    MaxDiscards,
}

impl Copy for ExhaustionReason {}

pub enum RunOutcome<T> {
    Passed { pub stats: RunStats },
    Exhausted {
        pub reason: ExhaustionReason,
        pub stats: RunStats,
    },
    Falsified {
        pub original: T,
        pub minimal: T,
        pub failure: FailureKey,
        pub stats: RunStats,
        pub shrink: ShrinkStats,
        pub shrink_status: ShrinkStatus,
    },
    InfrastructureError {
        pub error: ErrorCode,
        pub stats: RunStats,
    },
    ConfigurationError {
        pub error: ErrorCode,
        pub stats: RunStats,
    },
}

impl<T> Copy for RunOutcome<T> where T: Copy {}

pub fn verdict_tag(_ verdict: PropertyVerdict) -> u256 {
    match verdict {
        PropertyVerdict::Pass => 0,
        PropertyVerdict::Discard => 1,
        PropertyVerdict::Fail(_) => 2,
        PropertyVerdict::InfrastructureError(_) => 3,
    }
}

pub fn run_outcome_tag<T: Copy>(_ outcome: RunOutcome<T>) -> u256 {
    match outcome {
        RunOutcome::Passed { stats: _ } => 0,
        RunOutcome::Exhausted { reason: _, stats: _ } => 1,
        RunOutcome::Falsified {
            original: _,
            minimal: _,
            failure: _,
            stats: _,
            shrink: _,
            shrink_status: _,
        } => 2,
        RunOutcome::InfrastructureError { error: _, stats: _ } => 3,
        RunOutcome::ConfigurationError { error: _, stats: _ } => 4,
    }
}
